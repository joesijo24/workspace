411692&amp;cacheVersion=3D1&amp;api=3Dv2" data-height=3D"430" data-width=3D=
"1262" data-unresolved-comment-count=3D"0" data-linked-resource-id=3D"15039=
85693" data-linked-resource-version=3D"1" data-linked-resource-type=3D"atta=
chment" data-linked-resource-default-alias=3D"image-20260106-210823.png" da=
ta-base-url=3D"https://wrberkley.atlassian.net/wiki" data-linked-resource-c=
ontent-type=3D"image/png" data-linked-resource-container-id=3D"1504706565" =
data-linked-resource-container-version=3D"5" data-media-id=3D"d7024507-4f3e=
-4732-af08-5f8e825a05f6" data-media-type=3D"file" height=3D"159"></span>
<ul local-id=3D"1623ad0e-22c9-4852-be0c-aee762c6e862">
<li local-id=3D"bfc1896b-a2af-4acc-95ca-1daef7f6aa29">
<p local-id=3D"1c707ca4-d17c-410d-9e2a-53456d5dd45c"><strong>Name:</strong>=
 Name of the pipeline</p>
</li>
<li local-id=3D"b4d32402-4021-4c57-b47d-29839a3c7d8f">
<p local-id=3D"3e0a3376-2124-48b3-a5e1-105b8495eeb4"><strong>Description: <=
/strong>Brief description of the deployment pipeline</p>
</li>
<li local-id=3D"105b187e-5243-4826-b120-f11a907d30ca">
<p local-id=3D"8b967d82-cf4c-4fc6-8591-2adb72d4b271"><strong>Owner: </stron=
g>The owner of the deployment pipeline record, it was set to be owned by <e=
m><strong>svc-ent-d-pwpdyn02</strong></em></p>
</li>
<li local-id=3D"0c0ada87-8d0f-4527-827f-c6364ce55101">
<p local-id=3D"c31d0a50-7bd9-4688-b154-d5dc11d438b6"><strong>AI Deployment =
notes: </strong>Creates AI notes at the time of deployment, describing the =
components within the solution to be deployed</p>
</li>
<li local-id=3D"9bfabf79-459f-41f0-8cfd-ded658d66a79">
<p local-id=3D"a30becb2-6c78-451d-83f2-f58441c98a87"><strong>Allow redeploy=
ments of older versions: </strong>Allows to deploy a previous solution of t=
he solution in the pipeline</p>
</li>
<li local-id=3D"cc01ce24-5b35-4a0f-8fcb-061ba3961a19">
<p local-id=3D"5aa1e9c2-ba47-45fc-a6ec-b11ceab6aec2"><strong>Deployment Typ=
e:</strong> Allows the deployment to be from a source control or from power=
 platform (Standard), this can only be set on the creation of the deploymen=
t pipeline record</p>
</li>
</ul>
<p local-id=3D"9b5a0211-1214-43d5-b55d-733f50332063">The list below shows t=
he development environments linked to this deployment pipeline, in this cas=
e Dev01</p>
<span class=3D"confluence-embedded-file-wrapper image-center-wrapper conflu=
ence-embedded-manual-size"><img class=3D"confluence-embedded-image image-ce=
nter" alt=3D"image-20260106-212441.png" width=3D"468" loading=3D"lazy" src=
=3D"7f339893f04ef0a126d55fcadbdba477fac6b192bc8e373221b45d7f1912a8a6" data-=
image-src=3D"https://wrberkley.atlassian.net/wiki/download/attachments/1504=
