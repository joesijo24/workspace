<p local-id=3D"c68beaf6b52a"><strong>Set Regarding:</strong></p>
<p local-id=3D"caea5c2d5cb1">if <strong>objecttype </strong>code is <strong=
>Trip</strong></p>
<p local-id=3D"2d8354de5c8c">then Regarding (Trip) =3D</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">if(
   equals(triggerBody()?['text_7'],'wrb_trip'),
   concat(
      '/wrb_trips(',
      triggerBody()?['text_1'],
      ')'
   ),
   ''
)</pre>
</div>
</div>
<p local-id=3D"df9a58b2ed3b">if <strong>objecttype </strong>code is <strong=
>Account</strong></p>
<p local-id=3D"cc74f6a1db0e">then Regarding (Account) =3D</p>
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">if(
   equals(triggerBody()?['text_7'],'account'),
   concat(
      '/accounts(',
      triggerBody()?['text_1'],
      ')'
   ),
   ''
)</pre>
</div>
</div>
