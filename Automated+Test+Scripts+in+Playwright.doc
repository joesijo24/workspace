<col style=3D"width: 476.0px;">
</colgroup>
<tbody>
<tr data-local-id=3D"b6884ef534bb">
<th data-local-id=3D"000049d96940" class=3D"confluenceTh">
<p local-id=3D"5df327ca0449"><strong>Category</strong></p>
</th>
<th data-local-id=3D"24142d0a7e40" class=3D"confluenceTh">
<p local-id=3D"97b4951b755b"><strong>Name</strong></p>
</th>
