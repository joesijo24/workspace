comment-count=3D"0" data-linked-resource-id=3D"1581678623" data-linked-reso=
urce-version=3D"1" data-linked-resource-type=3D"attachment" data-linked-res=
ource-default-alias=3D"image-20260122-201839.png" data-base-url=3D"https://=
wrberkley.atlassian.net/wiki" data-linked-resource-content-type=3D"image/pn=
g" data-linked-resource-container-id=3D"1580498969" data-linked-resource-co=
ntainer-version=3D"3" data-media-id=3D"e55247e8-5426-400d-a6e0-b4db05dfe34e=
" data-media-type=3D"file" height=3D"193"></span></p>
<p local-id=3D"b40f1a45-7d0e-453f-a9af-17ad743a7108">Additional Links:</p>
<p local-id=3D"b5e80252-1d32-48e2-980d-d8f334898cfb"><a class=3D"external-l=
ink" href=3D"https://learn.microsoft.com/en-us/azure/devops/pipelines/libra=
ry/connect-to-azure?view=3Dazure-devops" rel=3D"nofollow">Use an Azure Reso=
urce Manager service connection - Azure Pipelines | Microsoft Learn</a></p>
    </div>
</body>
